{
  "name": "@affordmed/logging-middleware",
  "version": "1.0.0",
  "description": "Reusable logging middleware that authenticates and ships structured logs to the AffordMed evaluation service.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "test:smoke": "ts-node src/smoke.ts",
    "register": "ts-node src/register.ts"
  },
  "keywords": ["logging", "middleware", "affordmed", "observability"],
  "author": "Raktim Chandra",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
