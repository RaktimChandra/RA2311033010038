{
  "name": "vehicle-maintenance-scheduler",
  "version": "1.0.0",
  "description": "REST service that fetches depots and vehicle tasks from AffordMed APIs and selects the optimal task set per depot using a 0/1 knapsack DP.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\""
  },
  "author": "Raktim Chandra",
  "license": "MIT",
  "dependencies": {
    "@affordmed/logging-middleware": "file:../logging_middleware",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
